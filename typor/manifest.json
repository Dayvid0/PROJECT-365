{
  "manifest_version": 3,
  "name": "Typing Automator",
  "version": "1.0.0",
  "description": "Automated typing tool with speed control and DOCX support",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "notifications",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "start-typing": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start typing the saved text"
    },
    "stop-typing": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop typing"
    }
  }
}
