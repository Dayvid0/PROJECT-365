# PROJECT_365 Web — copy to .env.local and fill in a real secret.
# NEVER commit .env.local or any real secret values.

# Local SQLite by default. In production use libsql://<db>-<org>.turso.io.
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-character-random-secret"

# Must match the origin you browse. Next dev may move to :3001 if :3000 is busy.
BETTER_AUTH_URL="http://localhost:3000"

# Public discovery stays closed unless BOTH values are set. Comma-separated
# exact account emails are the only users who can approve challenges/reports.
MODERATOR_EMAILS="reviewer@example.com"
# Shown in community rules for reports, decisions, and appeals.
MODERATOR_CONTACT_EMAIL="safety@example.com"
